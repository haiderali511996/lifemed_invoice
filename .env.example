# Copy this file to `.env` in the project root and fill in real values.
# Never commit the real .env - it is gitignored.

# Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

DEBUG=False

# Comma-separated hostnames (no scheme, no trailing slash)
ALLOWED_HOSTS=invoice.lifemedpharmaceutical.com

# Comma-separated origins allowed to POST (scheme required).
# Keep the http:// entry only while the subdomain has no SSL certificate.
CSRF_TRUSTED_ORIGINS=http://invoice.lifemedpharmaceutical.com,https://invoice.lifemedpharmaceutical.com

# IMPORTANT: must stay False while the site is served over plain http://.
# Secure cookies are dropped by the browser on http, so login would appear to
# do nothing. Switch to True once cPanel AutoSSL has issued a certificate.
SECURE_COOKIES=False

# Enable together with SECURE_COOKIES once SSL is active
USE_X_FORWARDED_PROTO=False

# Where invoice numbering starts when the database has no invoices yet.
# Set this on a fresh database so new invoices continue past the last number
# already issued to customers rather than reusing it. Ignored once any
# invoice exists - numbering then continues from the highest one.
# INVOICE_START_NUMBER=9973

# cPanel MySQL database (cPanel > MySQL Databases).
# Both the username and the database name carry the cPanel account prefix.
# If the password contains @ : / or #, percent-encode it (@ becomes %40).
DATABASE_URL=mysql://cpuser_invoice:dbpassword@localhost:3306/cpuser_invoicedb

# Database backups (manage.py backup_db, run from cron - see DEPLOY_CPANEL.md)
# BACKUP_DIR=/home/cpuser/backups
# BACKUP_KEEP_DAYS=14
